#include <iostream>
#include <fstream>
using namespace std;

int main() {
    ifstream file("data.txt");

    file.seekg(10);  // move to 10th byte
    cout << "Current position: " << file.tellg() << endl;

    char ch;
    cout << "Remaining content:\n";
    while(file.get(ch)) {
        cout << ch;
    }

    file.close();
    return 0;
}
