#ifndef STACK_TEMPLATE_H
#define STACK_TEMPLATE_H

#include <iostream>
#include <stdexcept>
using namespace std;

template <typename T>
class Stack {
private:
    T *arr;
    int top;
    int capacity;
    
public:
    Stack(int size = 100) {
        capacity = size;
        arr = new T[capacity];
        top = -1;
    }
    
    ~Stack() {
        delete[] arr;
    }
    
    void push(T value) {
        if (top == capacity - 1) {
            cout << "Stack Overflow!" << endl;
            return;
        }
        arr[++top] = value;
    }
    
    T pop() {
        if (top == -1) {
            throw runtime_error("Stack Underflow!");
        }
        return arr[top--];
    }
    
    bool isEmpty() {
        return top == -1;
    }
    
    T peek() {
        if (top == -1) {
            throw runtime_error("Stack is empty!");
        }
        return arr[top];
    }
};

#endif
