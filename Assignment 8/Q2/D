#ifndef ARITHMETIC_TEMPLATE_H
#define ARITHMETIC_TEMPLATE_H

#include <stdexcept>
using namespace std;

template <typename T>
class Arithmetic {
public:
    T add(T a, T b) { 
        return a + b; 
    }
    
    T subtract(T a, T b) { 
        return a - b; 
    }
    
    T multiply(T a, T b) { 
        return a * b; 
    }
    
    T divide(T a, T b) { 
        if (b == 0) {
            throw runtime_error("Division by zero!");
        }
        return a / b; 
    }
};

#endif
