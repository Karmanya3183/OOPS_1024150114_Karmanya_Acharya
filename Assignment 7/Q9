#include <iostream>
#include <vector>
using namespace std;

class Accumulator {
    vector<int> data;
public:
    Accumulator& operator()(int x) {
        data.push_back(x);
        return *this;
    }

    void show() {
        cout << "Data: ";
        for (int x : data)
            cout << x << " ";
        cout << endl;
    }
};

int main() {
    Accumulator a;
    a(10)(20)(30);   // successive calls using ()
    a.show();
    return 0;
}
