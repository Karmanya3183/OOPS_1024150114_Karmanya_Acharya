#include <iostream>
using namespace std;

class Shape {
public:
    virtual float area() = 0;        // pure virtual
    virtual void display() = 0;      // pure virtual
};

class Circle : public Shape {
    float r;
public:
    Circle(float radius) : r(radius) {}
    float area() override {
        return 3.14f * r * r;
    }
    void display() override {
        cout << "Circle area = " << area() << endl;
    }
};

class Rectangle : public Shape {
    float w, h;
public:
    Rectangle(float width, float height) : w(width), h(height) {}
    float area() override {
        return w * h;
    }
    void display() override {
        cout << "Rectangle area = " << area() << endl;
    }
};

class Triangle : public Shape {
    float b, h;
public:
    Triangle(float base, float height) : b(base), h(height) {}
    float area() override {
        return 0.5f * b * h;
    }
    void display() override {
        cout << "Triangle area = " << area() << endl;
    }
};

int main() {
    Shape* s[3];
    s[0] = new Circle(5);
    s[1] = new Rectangle(6, 4);
    s[2] = new Triangle(10, 8);

    for (int i = 0; i < 3; i++) {
        s[i]->display();
    }

    return 0;
}
