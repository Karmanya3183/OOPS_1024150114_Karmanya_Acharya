#include <iostream>
#include <cstdlib>
using namespace std;

class BoundArray {
    int size;
    int* arr;
public:
    BoundArray(int n) : size(n) {
        arr = new int[size];
    }

    ~BoundArray() {
        delete[] arr;
    }

    // bounds‑checked index operator
    int& operator[](int i) {
        if (i < 0 || i >= size) {
            cerr << "Index out of bounds!\n";
            exit(1);
        }
        return arr[i];
    }
};

int main() {
    BoundArray a(5);
    a[0] = 10;
    a[1] = 20;
    // a[10] = 30;  // this will crash with index out of bounds
    cout << a[0] << " " << a[1] << endl;
    return 0;
}
