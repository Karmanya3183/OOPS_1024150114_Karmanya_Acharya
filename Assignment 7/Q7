#include <iostream>
using namespace std;

const int MAX = 5;

class Matrix {
    int rows, cols;
    int m[MAX][MAX];
public:
    Matrix(int r = 2, int c = 2) : rows(r), cols(c) {}
    void input();
    void output();
    friend Matrix operator*(const Matrix& a, const Matrix& b);
};

void Matrix::input() {
    cout << "Enter " << rows << " x " << cols << " matrix: \n";
    for (int i = 0; i < rows; i++)
        for (int j = 0; j < cols; j++)
            cin >> m[i][j];
}

void Matrix::output() {
    for (int i = 0; i < rows; i++) {
        for (int j = 0; j < cols; j++)
            cout << m[i][j] << " ";
        cout << endl;
    }
}

Matrix operator*(const Matrix& a, const Matrix& b) {
    Matrix result(a.rows, b.cols);
    for (int i = 0; i < result.rows; i++)
        for (int j = 0; j < result.cols; j++) {
            result.m[i][j] = 0;
            for (int k = 0; k < a.cols; k++)
                result.m[i][j] += a.m[i][k] * b.m[k][j];
        }
    return result;
}

int main() {
    Matrix m1(2, 3), m2(3, 2), m3;
    m1.input();
    m2.input();
    m3 = m1 * m2;
    m3.output();
    return 0;
}
