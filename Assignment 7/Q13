#include <iostream>
#include <cmath>
using namespace std;

class Cartesian {
    float x, y;
public:
    Cartesian(float a = 0, float b = 0) : x(a), y(b) {}

    void show() {
        cout << "Cartesian: x = " << x << ", y = " << y << endl;
    }
};

class Polar {
    float r, theta;   // in radians
public:
    Polar(float radius = 0, float angle = 0)
        : r(radius), theta(angle) {}

    // conversion from Polar to Cartesian
    operator Cartesian() {
        float x = r * cos(theta);
        float y = r * sin(theta);
        return Cartesian(x, y);
    }
};

int main() {
    Polar p(10, 0.78);   // angle ~45°
    Cartesian c = p;     // p → Cartesian
    c.show();
    return 0;
}
